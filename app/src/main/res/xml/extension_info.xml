<?xml version="1.0" encoding="utf-8"?>
<ExtensionInfo
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:id="altgraph"
    app:displayName="@string/app_name"
    app:icon="@drawable/ic_altigraph_logo">

    <DataType
        app:typeId="altimetria_graph"
        app:displayName="@string/data_type_altimetria_title"
        app:description="@string/data_type_altimetria_desc"
        app:graphical="true"
        app:icon="@drawable/ic_altigraph_logo" />

    <DataType
        app:typeId="apm_score"
        app:displayName="@string/data_type_apm_title"
        app:description="@string/data_type_apm_desc"
        app:graphical="false"
        app:icon="@drawable/ic_altigraph_logo" />

    <DataType
        app:typeId="climb_pacing"
        app:displayName="@string/data_type_climb_pacing_title"
        app:description="@string/data_type_climb_pacing_desc"
        app:graphical="false"
        app:icon="@drawable/ic_altigraph_logo" />

    <DataType
        app:typeId="gradient_trend"
        app:displayName="@string/data_type_gradient_trend_title"
        app:description="@string/data_type_gradient_trend_desc"
        app:graphical="false"
        app:icon="@drawable/ic_altigraph_logo" />

</ExtensionInfo>