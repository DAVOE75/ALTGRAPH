<?xml version="1.0" encoding="utf-8"?>
<resources>
    <attr name="id" format="string" />
    <attr name="typeId" format="string" />
    <attr name="label" format="string|reference" />
    <attr name="displayName" format="string|reference" />
    <attr name="description" format="string|reference" />
    <attr name="icon" format="reference" />
    <attr name="graphical" format="boolean" />
    <attr name="scansDevices" format="boolean" />
    <attr name="mapLayer" format="boolean" />
    <attr name="fitFile" format="boolean" />

    <declare-styleable name="Extension">
        <attr name="id" />
