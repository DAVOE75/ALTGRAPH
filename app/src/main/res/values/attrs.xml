        <attr name="displayName" />
        <attr name="icon" />
        <attr name="scansDevices" />
        <attr name="mapLayer" />
        <attr name="fitFile" />
    </declare-styleable>

    <declare-styleable name="DataType">
        <attr name="id" />
        <attr name="typeId" />
        <attr name="label" />
        <attr name="displayName" />
        <attr name="description" />
        <attr name="graphical" />
        <attr name="icon" />
    </declare-styleable>
