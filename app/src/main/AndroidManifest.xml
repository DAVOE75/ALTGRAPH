<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_altigraph_logo"
        android:roundIcon="@drawable/ic_altigraph_logo"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat">

        <meta-data
            android:name="io.hammerhead.karooext.MANIFEST_URL"
            android:value="https://raw.githubusercontent.com/DAVOE75/ALTGRAPH/main/manifest.json" />

        <service
            android:name=".AltimetriaExtensionService"
            android:exported="true">
            <intent-filter>
                <action android:name="io.hammerhead.karooext.KAROO_EXTENSION" />
            </intent-filter>
            <meta-data
                android:name="io.hammerhead.karooext.EXTENSION_INFO"
                android:resource="@xml/extension_info" />
        </service>

    </application>

</manifest>